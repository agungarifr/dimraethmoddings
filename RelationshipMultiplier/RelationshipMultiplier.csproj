<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RelationshipMultiplier</AssemblyName>
    <RootNamespace>Dimraeth.RelationshipMultiplier</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <!--
    Referensi ke instalasi lokal game (BepInEx 6 / Il2Cpp).
    Sesuaikan BASE_PATH bila folder game berpindah.
    Mod ini TIDAK perlu dideploy: cukup buka di Visual Studio / `dotnet build`
    lalu hasilnya siap di-port ke dalam CumisModifier.
  -->
  <PropertyGroup>
    <GameRoot>D:\SteamLibrary\steamapps\common\Dimraeth</GameRoot>
    <BepInExCore>$(GameRoot)\BepInEx\core</BepInExCore>
    <BepInExInterop>$(GameRoot)\BepInEx\interop</BepInExInterop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game interop (hasil generate Il2CppInterop) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BepInExInterop)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExInterop)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExInterop)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(BepInExInterop)\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>