{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "midas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Midas",
      "options": {
        "baseURL": "https://midas-stage.telkomdigital.id/v1",
        "apiKey": "{env:MIDAS_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "glm-5.2": { "name": "GLM 5.2" },
        "kimi-k2-code": { "name": "Kimi K2 Code" },
        "mimo": { "name": "Mimo" },
        "mimo-pro": { "name": "Mimo Pro" }
      }
    }
  },
  "model": "midas/mimo",
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "cwd": "modding/BepInExModsSource",
        "disabled": false,
        "codemode": false
      },
      "memory": {
        "type": "local",
        "command": ["memento"],
        "environment": {
          "MEMORY_DB_PATH": "C:\\Users\\<you>\\.local\\share\\memento\\memory.db"
        },
        "timeout": { "startup": 60000 },
        "disabled": false
      }
    }
  }
}
